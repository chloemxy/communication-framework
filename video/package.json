{
  "name": "prism-slide-animations",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AiSlices ../presentation/media/bg/ai-slices.mp4 --gl=angle --crf=20 --color-space=bt709",
    "render:prism": "remotion render src/index.ts AiToPrism ../presentation/media/bg/ai-to-prism.mp4 --gl=angle --crf=18 --color-space=bt709",
    "render:reveal": "remotion render src/index.ts AiToReveal ../presentation/media/bg/ai-to-reveal.mp4 --gl=angle --crf=12 --color-space=bt709",
    "render:reveal-light": "remotion render src/index.ts AiToRevealLight ../presentation/media/bg/ai-to-reveal-light.mp4 --gl=angle --crf=12 --scale=1.5 --color-space=bt709",
    "render:list": "remotion render src/index.ts FrameworksList ../presentation/media/bg/frameworks-list.mp4 --gl=angle --crf=20 --color-space=bt709",
    "render:flow": "remotion render src/index.ts FrameworksFlow ../presentation/media/bg/frameworks-flow.mp4 --crf=20"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.544",
    "@remotion/google-fonts": "^4.0.544",
    "@remotion/three": "^4.0.544",
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.544",
    "three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
